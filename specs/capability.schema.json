{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Asrai capability backlog v1",
  "type": "object",
  "required": ["schemaVersion", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "priority", "milestone", "description", "referenceBehaviour", "dependencies", "acceptanceCriteria", "evaluationStrategy", "status", "evidence", "completion"],
        "properties": {
          "id": { "type": "string", "pattern": "^FC[0-9]{3}$" },
          "priority": { "type": "integer", "minimum": 1 },
          "milestone": { "type": "string" },
          "description": { "type": "string", "minLength": 1 },
          "referenceBehaviour": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "source", "fixtures"],
            "properties": {
              "version": { "type": "string" },
              "source": { "type": "string" },
              "fixtures": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
            }
          },
          "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "acceptanceCriteria": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "evaluationStrategy": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "status": { "enum": ["pending", "ready", "implementing", "implemented", "accepted", "deferred"] },
          "evidence": {
            "type": "array",
            "items": { "type": "object", "required": ["report", "candidateSha256", "acceptanceSha256"], "properties": { "report": { "type": "string" }, "candidateSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "acceptanceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }
          },
          "completion": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
